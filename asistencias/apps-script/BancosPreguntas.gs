/**
 * Importación temporal de los bancos actuales a Google Sheets.
 *
 * Ejecuta crearHojasBancosPreguntas() desde la hoja destino. Convierte las
 * pestañas JSON existentes sin perder sus preguntas; si no existen, importa la
 * semilla. Cada reactivo queda en una fila con pregunta y respuestas separadas.
 */
var BancosPreguntas = (function () {
  var SEED_BANKS_BASE64 = [
    '',
    '',
    '',
    '',
    '',
    '',
    '',
    '',
    '',
    '',
    '',
    '',
    '',
    '',
    ''
  ].join('');
  var SHEETS = {
    cib: {
      tabs: {
        1: 'Banco_CIB_P1',
        2: 'Banco_CIB_P2'
      },
      partials: {
        1: ['BANK', 'BANK2', 'NAMES', 'PAIRS', 'RANGE', 'SUMBITS', 'SECS1', 'SECS2'],
        2: ['BANKJ', 'SECS_J']
      },
      questionKeys: {
        1: ['BANK', 'BANK2'],
        2: ['BANKJ']
      },
      configKeys: {
        1: ['NAMES', 'PAIRS', 'RANGE', 'SUMBITS', 'SECS1', 'SECS2'],
        2: ['SECS_J']
      },
      rootOrder: ['BANK', 'BANK2', 'BANKJ', 'NAMES', 'PAIRS', 'RANGE', 'SUMBITS', 'SECS1', 'SECS2', 'SECS_J']
    },
    est: {
      tabs: {
        1: 'Banco_EST_P1',
        2: 'Banco_EST_P2'
      },
      partials: {
        1: ['BANK1', 'SECS1'],
        2: ['BANK2', 'SECS2']
      },
      questionKeys: {
        1: ['BANK1'],
        2: ['BANK2']
      },
      configKeys: {
        1: ['SECS1'],
        2: ['SECS2']
      },
      rootOrder: ['BANK1', 'BANK2', 'SECS1', 'SECS2']
    }
  };
  var HEADERS = [
    'Banco',
    'Sección',
    'Tipo',
    'Orden (no cambiar)',
    'Pregunta',
    'Respuesta correcta',
    'Opción incorrecta 1',
    'Opción incorrecta 2',
    'Opción incorrecta 3',
    'Nivel Bloom'
  ];

  function validateBank_(bank, definition, label) {
    if (!bank || typeof bank !== 'object' || Array.isArray(bank)) {
      throw new Error('El banco "' + label + '" debe contener un objeto JSON.');
    }

    var expected = {};
    Object.keys(definition.partials).forEach(function (partial) {
      definition.partials[partial].forEach(function (key) { expected[key] = true; });
    });
    var missing = Object.keys(expected).filter(function (key) {
      return !Object.prototype.hasOwnProperty.call(bank, key);
    });
    var unknown = Object.keys(bank).filter(function (key) { return !expected[key]; });
    if (missing.length || unknown.length) {
      throw new Error(
        'El banco "' + label + '" no coincide con el formato esperado. ' +
        (missing.length ? 'Faltan: ' + missing.join(', ') + '. ' : '') +
        (unknown.length ? 'No reconocidas: ' + unknown.join(', ') + '.' : '')
      );
    }
  }

  function seedBanks_() {
    var json = Utilities.newBlob(Utilities.base64Decode(SEED_BANKS_BASE64))
      .getDataAsString('UTF-8');
    return JSON.parse(json);
  }

  function readLegacyPartial_(spreadsheet, definition, partial) {
    var sheet = spreadsheet.getSheetByName(definition.tabs[partial]);
    var stored = {};
    if (!sheet || sheet.getLastRow() < 2) {
      throw new Error('No hay datos JSON para convertir en "' + definition.tabs[partial] + '".');
    }
    sheet.getRange(2, 1, sheet.getLastRow() - 1, 2).getDisplayValues()
      .forEach(function (row, index) {
        var key = String(row[0] || '').trim(), value = String(row[1] || '').trim();
        if (!key && !value) return;
        if (definition.partials[partial].indexOf(key) === -1) {
          throw new Error('Clave no reconocida en ' + definition.tabs[partial] + ', fila ' + (index + 2) + ': ' + key);
        }
        if (Object.prototype.hasOwnProperty.call(stored, key)) {
          throw new Error('Clave duplicada en ' + definition.tabs[partial] + ': ' + key);
        }
        try {
          stored[key] = JSON.parse(value);
        } catch (error) {
          throw new Error('JSON inválido en ' + definition.tabs[partial] + ', fila ' + (index + 2) + ': ' + error.message);
        }
      });

    var missing = definition.partials[partial].filter(function (key) {
      return !Object.prototype.hasOwnProperty.call(stored, key);
    });
    if (missing.length) {
      throw new Error('Faltan claves en ' + definition.tabs[partial] + ': ' + missing.join(', ') + '.');
    }
    return stored;
  }

  function banksFromLegacySheets_(spreadsheet) {
    var banks = {};
    Object.keys(SHEETS).forEach(function (subject) {
      var definition = SHEETS[subject], bank = {};
      [1, 2].forEach(function (partial) {
        var stored = readLegacyPartial_(spreadsheet, definition, partial);
        definition.partials[partial].forEach(function (key) { bank[key] = stored[key]; });
      });
      validateBank_(bank, definition, subject);
      banks[subject] = bank;
    });
    return banks;
  }

  function rowsForPartial_(definition, bank, partial) {
    var rows = [];
    definition.questionKeys[partial].forEach(function (bankKey) {
      var categories = bank[bankKey];
      if (!categories || typeof categories !== 'object' || Array.isArray(categories)) {
        throw new Error('El banco "' + bankKey + '" debe contener secciones de preguntas.');
      }
      Object.keys(categories).forEach(function (category) {
        var variants = categories[category];
        if (!variants || typeof variants !== 'object' || Array.isArray(variants)) {
          throw new Error('La sección "' + category + '" del banco "' + bankKey + '" no es válida.');
        }
        Object.keys(variants).forEach(function (variant) {
          var questions = variants[variant];
          if (!Array.isArray(questions)) {
            throw new Error('Las preguntas de "' + bankKey + '.' + category + '.' + variant + '" deben ser una lista.');
          }
          questions.forEach(function (question, index) {
            if (
              !question ||
              typeof question.q !== 'string' ||
              typeof question.ok !== 'string' ||
              !Array.isArray(question.bad) ||
              question.bad.length !== 3 ||
              question.bad.some(function (option) { return typeof option !== 'string'; }) ||
              (question.bl !== undefined && typeof question.bl !== 'string')
            ) {
              throw new Error('Reactivo inválido en "' + bankKey + '.' + category + '.' + variant + '", posición ' + (index + 1) + '.');
            }
            rows.push([
              bankKey,
              category,
              variant,
              index + 1,
              question.q,
              question.ok,
              question.bad[0],
              question.bad[1],
              question.bad[2],
              question.bl || ''
            ]);
          });
        });
      });
    });
    return rows;
  }

  function writeTab_(spreadsheet, name, rows) {
    var sheet = spreadsheet.getSheetByName(name);
    if (!sheet) sheet = spreadsheet.insertSheet(name);
    sheet.clear();
    sheet.getRange(1, 1, 1, HEADERS.length)
      .setValues([HEADERS])
      .setFontWeight('bold')
      .setBackground('#1e3a8a')
      .setFontColor('#ffffff');
    if (rows.length) {
      var range = sheet.getRange(2, 1, rows.length, HEADERS.length);
      range.setNumberFormat('@');
      range.setValues(rows);
    }
    sheet.setFrozenRows(1);
    [120, 110, 75, 120, 460, 360, 320, 320, 320, 120].forEach(function (width, index) {
      sheet.setColumnWidth(index + 1, width);
    });
    sheet.getDataRange().setWrap(true);
  }

  function importBanks_(banks) {
    var spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    if (!spreadsheet) throw new Error('Abre este proyecto desde la hoja de cálculo donde crearás los bancos.');
    if (!banks || typeof banks !== 'object' || Array.isArray(banks)) {
      throw new Error('La semilla de bancos debe contener un objeto con las materias cib y est.');
    }

    var missingSubjects = Object.keys(SHEETS).filter(function (subject) {
      return !Object.prototype.hasOwnProperty.call(banks, subject);
    });
    var unknownSubjects = Object.keys(banks).filter(function (subject) {
      return !Object.prototype.hasOwnProperty.call(SHEETS, subject);
    });
    if (missingSubjects.length || unknownSubjects.length) {
      throw new Error(
        'La semilla de bancos no coincide con las materias esperadas. ' +
        (missingSubjects.length ? 'Faltan: ' + missingSubjects.join(', ') + '. ' : '') +
        (unknownSubjects.length ? 'No reconocidas: ' + unknownSubjects.join(', ') + '.' : '')
      );
    }

    var rows = {};
    Object.keys(SHEETS).forEach(function (subject) {
      var definition = SHEETS[subject];
      validateBank_(banks[subject], definition, subject);
      rows[subject] = {};
      [1, 2].forEach(function (partial) {
        rows[subject][partial] = rowsForPartial_(definition, banks[subject], partial);
      });
    });

    Object.keys(SHEETS).forEach(function (subject) {
      var definition = SHEETS[subject];
      [1, 2].forEach(function (partial) {
        writeTab_(spreadsheet, definition.tabs[partial], rows[subject][partial]);
      });
    });
    SpreadsheetApp.flush();
    return 'Preguntas en columnas editables: Banco_CIB_P1, Banco_CIB_P2, Banco_EST_P1 y Banco_EST_P2.';
  }

  function initializeSheets() {
    var spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    if (!spreadsheet) throw new Error('Abre este proyecto desde la hoja de cálculo donde crearás los bancos.');

    var formats = [];
    Object.keys(SHEETS).forEach(function (subject) {
      var definition = SHEETS[subject];
      [1, 2].forEach(function (partial) {
        var sheet = spreadsheet.getSheetByName(definition.tabs[partial]);
        if (!sheet) {
          formats.push('missing');
          return;
        }
        var headers = sheet.getRange(1, 1, 1, HEADERS.length).getDisplayValues()[0];
        if (headers[0] === 'Clave' && headers[1] === 'Contenido JSON') {
          formats.push('legacy');
        } else if (HEADERS.every(function (header, index) { return headers[index] === header; })) {
          formats.push('columns');
        } else {
          formats.push('unknown');
        }
      });
    });

    if (formats.every(function (format) { return format === 'columns'; })) {
      return 'Las cuatro pestañas ya tienen columnas editables; no se modificaron.';
    }
    if (formats.every(function (format) { return format === 'missing'; })) {
      return importBanks_(seedBanks_());
    }
    if (formats.every(function (format) { return format === 'legacy'; })) {
      var banks = banksFromLegacySheets_(spreadsheet);
      return 'Preguntas JSON convertidas a columnas. ' + importBanks_(banks);
    }
    throw new Error(
      'No se cambiaron las pestañas: se detectó una mezcla de formatos, datos o encabezados. ' +
      'Revisa Banco_CIB_P1, Banco_CIB_P2, Banco_EST_P1 y Banco_EST_P2 antes de continuar.'
    );
  }

  function readPartialFromSheets(subject, partial) {
    subject = String(subject || '').toLowerCase();
    var definition = SHEETS[subject];
    if (!definition) throw new Error('Materia inválida. Usa "cib" o "est".');
    partial = Number(partial);
    if (partial !== 1 && partial !== 2) throw new Error('Parcial inválido. Usa 1 o 2.');

    var spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    if (!spreadsheet) throw new Error('No hay una hoja de cálculo activa para leer los bancos.');
    var sheet = spreadsheet.getSheetByName(definition.tabs[partial]);
    if (!sheet) throw new Error('No existe la pestaña "' + definition.tabs[partial] + '".');
    if (sheet.getLastRow() < 2) throw new Error('La pestaña "' + definition.tabs[partial] + '" no tiene datos.');
    var headers = sheet.getRange(1, 1, 1, HEADERS.length).getDisplayValues()[0];
    if (!HEADERS.every(function (header, index) { return headers[index] === header; })) {
      throw new Error('Los encabezados de "' + definition.tabs[partial] + '" no corresponden al formato editable.');
    }
    var seed = seedBanks_()[subject], grouped = {};
    sheet.getRange(2, 1, sheet.getLastRow() - 1, HEADERS.length).getDisplayValues()
      .forEach(function (row, index) {
        var line = index + 2;
        if (row.every(function (cell) { return !String(cell || '').trim(); })) return;

        var bankKey = String(row[0] || '').trim();
        var category = String(row[1] || '').trim();
        var variant = String(row[2] || '').trim();
        var order = Number(row[3]);
        var question = String(row[4] || '');
        var correct = String(row[5] || '');
        var bad = [row[6], row[7], row[8]].map(function (option) { return String(option || ''); });
        var bloom = String(row[9] || '');

        if (definition.questionKeys[partial].indexOf(bankKey) === -1) {
          throw new Error('Banco no reconocido en ' + definition.tabs[partial] + ', fila ' + line + ': ' + bankKey);
        }
        if (
          !seed[bankKey] ||
          !seed[bankKey][category] ||
          !Array.isArray(seed[bankKey][category][variant])
        ) {
          throw new Error('Banco, sección o tipo no reconocido en ' + definition.tabs[partial] + ', fila ' + line + '.');
        }
        if (!Number.isInteger(order) || order < 1) {
          throw new Error('El orden debe ser un entero positivo en ' + definition.tabs[partial] + ', fila ' + line + '.');
        }
        if (!question.trim() || !correct.trim() || bad.some(function (option) { return !option.trim(); })) {
          throw new Error('Completa pregunta, respuesta correcta y las tres opciones incorrectas en la fila ' + line + '.');
        }
        var groupKey = JSON.stringify([bankKey, category, variant]);
        if (!grouped[groupKey]) grouped[groupKey] = {};
        if (Object.prototype.hasOwnProperty.call(grouped[groupKey], order)) {
          throw new Error('Orden duplicado para ' + bankKey + '.' + category + '.' + variant + ' en la fila ' + line + '.');
        }
        var item = {
          q: question,
          ok: correct,
          bad: bad
        };
        if (bloom) item.bl = bloom;
        grouped[groupKey][order] = item;
      });

    var questionsByBank = {};
    definition.questionKeys[partial].forEach(function (bankKey) {
      questionsByBank[bankKey] = {};
      Object.keys(seed[bankKey]).forEach(function (category) {
        questionsByBank[bankKey][category] = {};
        Object.keys(seed[bankKey][category]).forEach(function (variant) {
          var expected = seed[bankKey][category][variant];
          var groupKey = JSON.stringify([bankKey, category, variant]);
          var entries = grouped[groupKey] || {};
          if (Object.keys(entries).length !== expected.length) {
            throw new Error(
              'No borres ni agregues filas de ' + bankKey + '.' + category + '.' + variant +
              '; edita el contenido de las filas existentes.'
            );
          }
          questionsByBank[bankKey][category][variant] = expected.map(function (unused, index) {
            var order = index + 1;
            if (!Object.prototype.hasOwnProperty.call(entries, order)) {
              throw new Error('Falta el orden ' + order + ' en ' + bankKey + '.' + category + '.' + variant + '.');
            }
            return entries[order];
          });
        });
      });
    });

    var bank = {};
    definition.rootOrder.filter(function (key) {
      return definition.partials[partial].indexOf(key) !== -1;
    }).forEach(function (key) {
      if (definition.questionKeys[partial].indexOf(key) !== -1) {
        bank[key] = questionsByBank[key];
      } else if (definition.configKeys[partial].indexOf(key) !== -1) {
        if (!Object.prototype.hasOwnProperty.call(seed, key)) {
          throw new Error('Falta la configuración técnica "' + key + '" para ' + subject + '.');
        }
        bank[key] = seed[key];
      } else {
        throw new Error('La clave "' + key + '" no está clasificada como pregunta ni configuración.');
      }
    });
    var revision = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, JSON.stringify(bank))
      .map(function (byte) { return ('0' + ((byte + 256) % 256).toString(16)).slice(-2); })
      .join('');
    return { bank: bank, revision: revision };
  }

  function readFromSheets(subject) {
    subject = String(subject || '').toLowerCase();
    var definition = SHEETS[subject];
    if (!definition) throw new Error('Materia inválida. Usa "cib" o "est".');
    var first = readPartialFromSheets(subject, 1).bank;
    var second = readPartialFromSheets(subject, 2).bank;
    var combined = Object.assign({}, first, second), bank = {};
    definition.rootOrder.forEach(function (key) { bank[key] = combined[key]; });
    return bank;
  }

  return {
    initializeSheets: initializeSheets,
    readFromSheets: readFromSheets,
    readPartialFromSheets: readPartialFromSheets
  };
})();

function crearHojasBancosPreguntas() {
  return BancosPreguntas.initializeSheets();
}

function leerBancoPreguntasDesdeHojas(materia) {
  return BancosPreguntas.readFromSheets(materia);
}

function leerBancoParcialDesdeHojas(materia, parcial) {
  return BancosPreguntas.readPartialFromSheets(materia, parcial);
}
